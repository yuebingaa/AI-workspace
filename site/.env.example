DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
NEXT_PUBLIC_ICP_LICENSE=
HARNESS_MODEL_REQUEST_TIMEOUT_MS=25000
HARNESS_TOOL_CALL_TIMEOUT_MS=10000
HARNESS_TOTAL_EXECUTION_TIMEOUT_MS=90000
HARNESS_MAX_MODEL_CALLS=6
HARNESS_MAX_TOOL_CALLS=6
# 多 Agent 最小闭环：single 保持现有执行；data 为复杂只读首轮任务启用主 Agent + 数据子 Agent。
# 共享原有模型 / 工具 / 时间预算；页面修改、追问和 Live 评测仍走单 Agent。
HARNESS_MULTI_AGENT_MODE=single
# 多步骤任务默认累计输入预算为 48000 tokens / 96000 字符；只在需要覆盖默认值时填写。
# 安全硬上限分别为 96000 tokens / 192000 字符，单次模型输入限制保持不变。
HARNESS_MAX_TOTAL_PROMPT_TOKENS=
HARNESS_MAX_TOTAL_INPUT_CHARS=
# 本地视觉验证：仅允许 HARNESS_VISUAL_BASE_URL 指向 localhost/127.0.0.0/8/::1。
HARNESS_VISUAL_VERIFICATION_ENABLED=0
HARNESS_VISUAL_BASE_URL=http://localhost:3000/
HARNESS_VISUAL_VERIFICATION_TIMEOUT_MS=35000
# Vinext/Workers 不能直接装载 Playwright 浏览器驱动；开发脚本会在此地址启动本机截图服务。
HARNESS_PLAYWRIGHT_CAPTURE_URL=http://127.0.0.1:3198/capture
# 使用支持 OpenAI Chat Completions 图像输入格式的多模态模型服务。
HARNESS_VISION_API_URL=https://api.openai.com/v1/chat/completions
HARNESS_VISION_API_KEY=
HARNESS_VISION_MODEL=
# 可选；留空时 Playwright 使用本机 Microsoft Edge channel。
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
STUDIO_LOCAL_STATE_DIR=

# SQL 连接默认为空。完整示例和只读授权说明见 docs/sql-connections.md。
# 仅填写连接元数据和凭据环境变量名称；真实凭据放在私有 .env.local。
STUDIO_SQL_CONNECTIONS=

# Harness MCP：配置只保存服务器地址、命令和环境变量名，禁止把 Token 直接写进 JSON。
HARNESS_MCP_ENABLED=0
HARNESS_MCP_CONFIG_PATH=./mcp.config.json
# 与 CONFIG_PATH 二选一；适合托管环境。
HARNESS_MCP_CONFIG_JSON=
# STDIO 会启动本地进程，只应在可信的本地/专用 Node.js 主机启用。
HARNESS_MCP_ALLOW_STDIO=0
