{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "docs:agent:check": "node scripts/check-agent-architecture.mjs",
    "docs:agent:test": "node --test scripts/check-agent-architecture.test.mjs",
    "docs:agent:sync": "node scripts/check-agent-architecture.mjs --sync",
    "pretest": "npm run docs:agent:check",
    "prebuild": "npm run docs:agent:check",
    "dev": "node scripts/dev-with-visual-service.mjs",
    "dev:app": "vinext dev",
    "build": "vinext build && node scripts/copy-wecom-cli.mjs && node scripts/copy-notebook-runtime.mjs",
    "build:portable:windows": "npm run build && node scripts/build-portable-windows.mjs",
    "package:portable:windows": "node scripts/package-portable-windows.mjs",
    "test:portable": "node --test scripts/package-portable-windows.test.mjs",
    "build:edgeone": "next build",
    "start": "vinext start",
    "site:install": "node scripts/runtime/site-runtime.mjs install",
    "site:update-manager": "node scripts/runtime/site-runtime.mjs update-manager",
    "site:publish": "node scripts/runtime/site-runtime.mjs publish",
    "site:rollback": "node scripts/runtime/site-runtime.mjs rollback",
    "site:start": "node scripts/runtime/site-runtime.mjs start",
    "site:stop": "node scripts/runtime/site-runtime.mjs stop",
    "site:restart": "node scripts/runtime/site-runtime.mjs restart",
    "site:status": "node scripts/runtime/site-runtime.mjs status",
    "site:logs": "node scripts/runtime/site-runtime.mjs logs",
    "test:runtime": "node --test scripts/runtime/runtime.test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern evidence",
    "test": "node scripts/run-offline-tests.mjs",
    "test:tools:unit": "node --test scripts/eds-browser-acceptance.test.mjs scripts/run-offline-tests.test.mjs",
    "test:eds:browser": "node scripts/eds-browser-acceptance.mjs",
    "test:eds:browser:unit": "node --test scripts/eds-browser-acceptance.test.mjs",
    "test:backup:browser": "node scripts/studio-backup-browser-acceptance.mjs",
    "test:eds:download": "node scripts/verify-eds-download.mjs",
    "test:eds:real": "vitest run core/eds/server/real-workbook.acceptance.test.ts --reporter=verbose",
    "test:eval": "vitest run core/evaluation/harness-evaluation.test.ts --reporter=verbose",
    "test:eval:live": "vitest run --config vitest.live.config.ts --reporter=verbose"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@puckeditor/core": "0.23.0",
    "@wecom/cli": "1.2.1",
    "apache-arrow": "17.0.0",
    "csv-parse": "7.0.2",
    "fflate": "0.8.3",
    "next": "16.3.4",
    "pg": "8.16.3",
    "playwright-core": "^1.62.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-is": "19.2.6",
    "read-excel-file": "9.3.10",
    "recharts": "3.10.1",
    "write-excel-file": "4.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "vitest": "^4.1.11",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
